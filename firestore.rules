rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isActiveAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == 'active' &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    // Every signed-in user may read their own admin record — this is the
    // document AuthContext checks right after login to decide whether to
    // let them into the panel at all, so it can't itself require isActiveAdmin().
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false; // manage admin accounts from the Firebase Console for now
    }

    // User Management + Profile Management "create a new user" flow: active
    // admins can read/update user records (block/unblock, soft delete) AND
    // now create them directly (Add Profile's "Create New User" option).
    // Hard-deleting user documents through the client is still locked out.
    match /users/{userId} {
      allow read: if isActiveAdmin();
      allow create: if isActiveAdmin();
      allow update: if isActiveAdmin();
      allow delete: if false;
    }

    // Profile Management module: active admins can read, create, and update
    // profiles (drafts, publishing, hide/restore, and the soft-delete
    // update). Hard delete stays locked out — see softDeleteProfile.
    match /profiles/{profileId} {
      allow read: if isActiveAdmin();
      allow create: if isActiveAdmin();
      allow update: if isActiveAdmin();
      allow delete: if false;
    }

    // User Subscriptions module: active admins can read/create/update
    // subscription assignment records (assign, renew, extend, cancel — all
    // of which are updates, since cancel only flips status and never
    // deletes). Hard delete is never exposed — see cancelSubscription.
    match /subscriptions/{subscriptionId} {
      allow read: if isActiveAdmin();
      allow create: if isActiveAdmin();
      allow update: if isActiveAdmin();
      allow delete: if false;
    }

    // Subscription Management module: active admins can fully manage plans
    // (create, edit, activate/deactivate via update, and delete — the "not
    // if assigned to users" guard is enforced in subscriptionService.js,
    // not here, since Firestore rules can check specific documents but
    // can't run an arbitrary "does any doc in another collection reference
    // this one" query the way application code can).
    match /subscriptionPlans/{planId} {
      allow read: if isActiveAdmin();
      allow create: if isActiveAdmin();
      allow update: if isActiveAdmin();
      allow delete: if isActiveAdmin();
    }

    // Payments module: active admins can read/create/update payment
    // records (create, mark success/failed, retry, cancel, refund — all
    // updates, never a real delete). Never permanently removed — see
    // refundPayment/cancelPayment in paymentService.js.
    match /payments/{paymentId} {
      allow read: if isActiveAdmin();
      allow create: if isActiveAdmin();
      allow update: if isActiveAdmin();
      allow delete: if false;
    }

    // Audit log: any active admin can append entries (Assign/Renew/Extend/
    // Cancel each write one), but never edit or delete existing ones —
    // an audit trail that could be rewritten isn't an audit trail.
    match /activityLogs/{logId} {
      allow read: if isActiveAdmin();
      allow create: if isActiveAdmin();
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
