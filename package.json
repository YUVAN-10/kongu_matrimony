{
  "name": "kongu-matrimony",
  "version": "1.0.0",
  "private": true,
  "description": "Kongu Matrimony - Full-Stack Monorepo (Client + Server)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm --prefix client run dev",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "server": "npm --prefix server run dev",
    "server:start": "npm --prefix server start",
    "build": "npm --prefix client run build"
  }
}
